# ---------------------------------------------------------------------------
# Smart Commute Assistant — environment template
#   cp .env.example backend/.env   and fill in your own credentials.
# Variable names below match os.getenv() call sites in backend/app/ exactly.
# ---------------------------------------------------------------------------

APP_NAME=Smart Commute Assistant
APP_ENV=local

# --- Database --------------------------------------------------------------
# db.py uses sqlalchemy.create_engine (synchronous). An async driver such as
# asyncpg will not work. psycopg2-binary is what backend/requirements.txt
# installs; on Python 3.14 without build tooling it fails to compile, in which
# case install pg8000 and use postgresql+pg8000:// instead.
# Leave DATABASE_URL unset to fall back to sqlite:///./smart_commute.db.
DATABASE_URL=postgresql+psycopg2://commute:commute@postgres:5432/commute

# --- Required to boot ------------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# --- Required for the decision engine to return a real plan ----------------
# Without these, _compute_today_plan() returns coords_missing or degrades to a
# generic transit suggestion. See docs/decision-engine.md#degradation.
GOOGLE_MAPS_API_KEY=          # Routes API + Geocoding API, billing enabled
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
CWA_API_KEY=                  # Central Weather Administration Open Data

# --- Optional --------------------------------------------------------------
# redis_cache.py falls back to an in-process dict when Redis is unreachable.
# No Redis service is declared in render.yaml, so the fallback is what runs in
# production. See docs/known-issues.md#d-2celery-and-redis-are-declared-but-not-deployed
REDIS_URL=redis://redis:6379/0

# Public base URL used to build LIFF and dashboard links sent over LINE.
PUBLIC_URL=
BASE_URL=

# LIFF application ID. Not a secret — it is in every URL the user taps — but it is
# deployment configuration. Defaults to the author's ID if unset.
LIFF_ID=

# Guards the undelete endpoints on the dashboard router.
UNDELETE_API_KEY=
