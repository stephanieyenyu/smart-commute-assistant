            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c21" value="三個階段是可跳過的，不是循序的。&lt;br&gt;每條轉移各自獨立守衛。使用者若在出門前&lt;br&gt;20 分鐘才設排程，就不會進入 T−60 的窗，&lt;br&gt;而 T−5 的階段照常觸發。畫成鏈狀只因為&lt;br&gt;那是常見路徑，不是狀態本身有序。&lt;br&gt;&lt;br&gt;已過窗的階段不補送。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="360" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="curved=0;startArrow=none;endArrow=none;dashed=1;strokeColor=#b8b39a;html=1;" edge="1" parent="1" source="c6" target="c21">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="凍結一次的理由：tick 每 30 秒跑一次，&lt;br&gt;若每次重算路線，等於每位使用者每天約&lt;br&gt;2,880 次對外 API 呼叫。改為算一次寫進&lt;br&gt;frozen_* 三欄，之後每次 tick 只是純粹的&lt;br&gt;時間戳比較。" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="250" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="curved=0;startArrow=none;endArrow=none;dashed=1;strokeColor=#b8b39a;html=1;" edge="1" parent="1" source="c5" target="c23">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="三個觸發窗" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="790" y="110" width="300" height="24" as="geometry" />
        </mxCell>
