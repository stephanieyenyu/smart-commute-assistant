        <mxCell id="c20" value="任何時點 departed_at 被寫入
即直接跳到終止" style="curved=1;startArrow=none;endArrow=classic;endSize=9;fillColor=none;strokeColor=light-dark(#333333,#cccccc);html=1;fontSize=12;labelBackgroundColor=#E8E8E88D;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);dashed=1;" edge="1" parent="1" source="c5" target="c9">
          <mxGeometry relative="1" as="geometry">
