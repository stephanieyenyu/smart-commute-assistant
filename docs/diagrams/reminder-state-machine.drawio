          <mxGeometry x="988" y="226" width="8" height="8" as="geometry" />
        </mxCell>
        <mxCell id="c43" value="" style="ellipse;html=1;fillColor=#666666;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1014" y="226" width="8" height="8" as="geometry" />
        </mxCell>
        <mxCell id="c44" value="tick 每 30 秒　·　紅點＝落在窗內" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="806" y="288" width="300" height="16" as="geometry" />
        </mxCell>
        <mxCell id="c45" value="&lt;b&gt;常數&lt;/b&gt;　reminder_scheduler.py&lt;br&gt;&lt;br&gt;SCHEDULER_TICK_SECONDS = 30&lt;br&gt;EXACT_TRIGGER_WINDOW_SECONDS = 75&lt;br&gt;STALE_REMINDER_GRACE_SECONDS = 120&lt;br&gt;PREPARE_RETRY_SECONDS = 300&lt;br&gt;MORNING_MONITOR_OFFSETS = { one_hour: 3600, five_min: 300 }&lt;br&gt;NIGHTLY_BRIEF = 21:00 Asia/Taipei" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontSize=10;size=12;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="330" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c46" value="&lt;b&gt;不變式&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;至少一次。&lt;/b&gt;窗 75 秒 ＞ tick 30 秒，保證每個窗內至少落一個 tick，&lt;br&gt;沒有階段會被漏掉。&lt;br&gt;&lt;br&gt;&lt;b&gt;至多一次。&lt;/b&gt;送出前檢查 *_sent_at、送出時寫入，因此落在同一個窗內&lt;br&gt;的兩到三個 tick 只會產生一則訊息。&lt;br&gt;&lt;br&gt;&lt;b&gt;兩者合起來&lt;/b&gt;才是「每階段每天恰好一次」。不需要鎖、佇列或精準&lt;br&gt;時間觸發器，而且缺任一半都不成立。&lt;br&gt;&lt;br&gt;&lt;font color='#b23b3b'&gt;&lt;b&gt;失效模式。&lt;/b&gt;為了錄影把 offset 壓縮（例如 one_hour 改 90 秒、&lt;br&gt;five_min 改 30 秒）卻不動 75 秒的窗，三個窗會重疊，三個階段在同一&lt;br&gt;個 tick 全部成立而一起送出。錯不在階段邏輯，而在於把窗當成常數，&lt;br&gt;但它其實是 offset 間距的函數。&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="480" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c47" value="&lt;b&gt;另一個 job&lt;/b&gt;　nightly_brief_job&lt;br&gt;&lt;br&gt;CronTrigger(hour=21, minute=0, timezone=&quot;Asia/Taipei&quot;)。與上面的 tick 及本狀態機無關，&lt;br&gt;由 nightly_brief_sent_at 與 nightly_brief_plan_key 守衛。&lt;br&gt;用 cron 而非時間窗，是因為它只有一個觸發時刻，沒有 offset 運算會算錯。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontSize=10;size=12;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="730" width="540" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c48" value="&lt;b&gt;早期草稿畫錯的地方&lt;/b&gt;　記錄下來，因為落差本身才是有用的部分&lt;br&gt;&lt;br&gt;1. 畫成三個排程 job。實際只有兩個 job，三個階段是同一個 tick 內的三條分支。&lt;br&gt;2. 畫成出門詢問會重試到被確認為止。實際只送一次，T+120 之後即放棄。&lt;br&gt;3. 畫成每階段各自重算路線。實際只凍結一次，之後每次 tick 都是讀取。" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fbfbf5;strokeColor=#b8b39a;fontSize=10;size=12;align=left;verticalAlign=top;spacingLeft=4;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="870" width="700" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c49" value="來源：backend/app/reminder_scheduler.py、reminder_timing.py @ e10e6d9（已逐項比對程式碼）" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="900" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
